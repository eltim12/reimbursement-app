PORT=3000
NODE_ENV=production

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=reimbursement_db
DB_PORT=3306

JWT_SECRET=change-me-to-a-long-random-string

# Apply schema migrate + system user seeds on server start (default: true)
RUN_SEEDS=true

# Reset management/finance/superadmin passwords to seeded values on each setup (default: true)
# Set to false after first deploy if you change those passwords manually
SEED_RESET_PASSWORDS=true

# Platform superadmin (company_id NULL). Created/updated by seed.
SUPERADMIN_EMAIL=superadmin@trimind.studio
SUPERADMIN_PASSWORD=TrimindSuper88!
