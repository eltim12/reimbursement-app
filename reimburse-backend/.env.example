PORT=3000
NODE_ENV=production

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=reimbursement_db
DB_PORT=3306

JWT_SECRET=change-me-to-a-long-random-string

# Apply schema migrate + system user seeds on server start (default: true)
RUN_SEEDS=true

# Reset management/finance passwords to seeded values on each setup (default: true)
# Set to false after first deploy if you change those passwords manually
SEED_RESET_PASSWORDS=true
